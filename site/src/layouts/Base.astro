---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/martian-mono/400.css";
import "@fontsource/martian-mono/500.css";
import "../styles/global.css";
import "katex/dist/katex.min.css";

interface Props {
  title: string;
  description?: string;
  current?: "wall";
}
const {
  title,
  description = "A wall of adaptive-mesh simulations built with samurai.",
  current,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Set the theme before first paint to avoid a flash. Defaults to the
         user's stored choice, else their OS preference. -->
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem("theme");
        } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top-bezel">
      <div class="room">
        <a class="wordmark" href={href("/")}>samurai <span class="etch">gallery</span></a>
        <nav class="top-nav" aria-label="Main">
          <a href={href("/")} aria-current={current === "wall" ? "page" : undefined}>Cases</a>
          <a class="ext" href="https://github.com/hpc-maths/samurai" target="_blank" rel="noopener">
            Source
            <svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"></path></svg>
          </a>
          <a class="ext" href="https://hpc-math-samurai.readthedocs.io" target="_blank" rel="noopener">
            Docs
            <svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"></path></svg>
          </a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch between light and dark theme">
            <svg class="to-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="to-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="bottom-bezel">
      <div class="room">
        <span>Every case rebuilds from its own folder with <a href="https://github.com/hpc-maths/samurai">samurai</a>.</span>
        <span>Add a case: open a pull request on <a href="https://github.com/hpc-maths/samurai-gallery">samurai-gallery</a>.</span>
      </div>
    </footer>

    <script is:inline>
      // Point every theme-aware media element (screens, case video) at the
      // variant of the active theme.
      function applyThemeMedia() {
        var light = document.documentElement.dataset.theme === "light";
        document.querySelectorAll("[data-dark][data-light]").forEach(function (el) {
          var url = light ? el.dataset.light : el.dataset.dark;
          if (!url || el.getAttribute("src") === url) return;
          if (el.tagName === "VIDEO") {
            if (!el.hasAttribute("src") && !el.dataset.eager) return;
            var poster = light ? el.dataset.posterLight : el.dataset.posterDark;
            var wasPlaying = !el.paused;
            el.src = url;
            if (poster) el.poster = poster;
            if (wasPlaying || el.autoplay) {
              var p = el.play();
              if (p && p.catch) p.catch(function () {});
            }
          } else {
            el.src = url;
          }
        });
      }
      window.applyThemeMedia = applyThemeMedia;
      applyThemeMedia();
      document.addEventListener("DOMContentLoaded", applyThemeMedia);

      document.getElementById("theme-toggle").addEventListener("click", function () {
        var next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch (e) {}
        applyThemeMedia();
      });
    </script>
  </body>
</html>
