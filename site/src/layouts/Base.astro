---
import "../styles/global.css";
import "katex/dist/katex.min.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "A gallery of adaptive-mesh simulations built with samurai." } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a class="brand" href={href("/")}>
          <span class="dot"></span>
          samurai <small>· gallery</small>
        </a>
        <nav class="nav-links">
          <a href={href("/")}>Cases</a>
          <a href="https://github.com/hpc-maths/samurai" target="_blank" rel="noopener">samurai</a>
          <a href="https://hpc-math-samurai.readthedocs.io" target="_blank" rel="noopener">Docs</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container inner">
        <span>Built with <a href="https://github.com/hpc-maths/samurai">samurai</a> · adaptive mesh refinement &amp; multiresolution.</span>
        <span>Contribute a case: open a pull request.</span>
      </div>
    </footer>
  </body>
</html>
