---
import type { GalleryCase } from "../lib/cases";
import { METHOD_LABELS } from "../lib/cases";

interface Props {
  item: GalleryCase;
  index: number;
}
const { item, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;

const num = String(index).padStart(2, "0");
const methodLabel = METHOD_LABELS[item.methods[0]] ?? item.methods[0] ?? "";
const dims = `d${item.dimension}`;
---

<a
  class="card"
  href={href(`/cases/${item.id}`)}
  data-methods={item.methods.join(" ")}
  data-adaptation={item.adaptation}
  data-dimension={dims}
  data-equation={item.equation}
>
  <div class="thumb">
    <div class="placeholder">rendering</div>
    <img
      class="theme-media"
      data-dark={href(item.thumbnailDarkUrl)}
      data-light={href(item.thumbnailLightUrl)}
      alt={item.title}
      loading="lazy"
      onerror="this.style.display='none'"
    />
  </div>
  <div class="meta-row">
    <span>Fig. {num}</span>
    <span>{methodLabel} · {item.dimension}D</span>
  </div>
  <h3>{item.title}</h3>
  <p>{item.summary}</p>
</a>
