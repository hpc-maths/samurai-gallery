---
import type { GalleryCase } from "../lib/cases";
import { METHOD_LABELS } from "../lib/cases";

interface Props {
  item: GalleryCase;
}
const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;

// data-* attributes drive the client-side filtering on the index page.
const dims = `d${item.dimension}`;
---

<a
  class="card"
  href={href(`/cases/${item.id}`)}
  data-methods={item.methods.join(" ")}
  data-adaptation={item.adaptation}
  data-dimension={dims}
  data-equation={item.equation}
>
  <div class="thumb">
    <div class="placeholder">preview rendering…</div>
    <img
      class="theme-media"
      src={href(item.thumbnailDarkUrl)}
      data-dark={href(item.thumbnailDarkUrl)}
      data-light={href(item.thumbnailLightUrl)}
      alt={item.title}
      loading="lazy"
      onerror="this.style.display='none'"
    />
    <span class="badge">{item.dimension}D</span>
  </div>
  <div class="body">
    <div class="tags">
      {item.methods.map((m) => <span class="tag method">{METHOD_LABELS[m] ?? m}</span>)}
    </div>
    <h3>{item.title}</h3>
    <p>{item.summary}</p>
  </div>
</a>
