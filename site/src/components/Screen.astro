---
import type { GalleryCase } from "../lib/cases";
import { METHOD_LABELS, facetValues, fieldSymbol, titleize } from "../lib/cases";

interface Props {
  item: GalleryCase;
  /** first screens of the wall load eagerly */
  eager?: boolean;
}
const { item, eager = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;

const media = item.media;
const aspect = media?.aspect ?? 1;
const size = aspect >= 1.8 ? "wide" : item.featured ? "big" : "";
const method = METHOD_LABELS[item.methods[0]] ?? titleize(item.methods[0] ?? "");
const etch = [
  media ? fieldSymbol(media.field) : null,
  `${item.dimension}D`,
  titleize(item.equation),
  media ? `${media.mesh.levels} levels` : null,
  media ? `${media.mesh.cells.toLocaleString("en-US")} cells` : null,
]
  .filter(Boolean)
  .join(" · ");

// Everything the console filters on, kept on the element so the wall filters
// in the browser.
const facets = facetValues(item);
const searchText = [item.title, item.summary, item.equation, method, item.engine ?? "", ...item.tags]
  .join(" ")
  .toLowerCase();
const imgW = 1200;
const imgH = Math.round(1200 / aspect);
---

<a
  class:list={["screen", size]}
  href={href(`/cases/${item.id}`)}
  style={`--ar:${aspect}`}
  data-facets={JSON.stringify(facets)}
  data-search={searchText}
>
  <div class="glass">
    {
      media ? (
        <>
          <img
            src={href(item.thumbnailDarkUrl)}
            data-dark={href(item.thumbnailDarkUrl)}
            data-light={href(item.thumbnailLightUrl)}
            alt={`${item.title}: ${media.dimension === 1 ? "solution profile" : "field and adaptive mesh"}`}
            width={imgW}
            height={imgH}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
          />
          <video
            data-dark={href(item.heroDarkUrl)}
            data-light={href(item.heroLightUrl)}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
          />
        </>
      ) : (
        <span class="no-signal etch">No signal: media not rendered yet</span>
      )
    }
  </div>
  <div class="plate">
    <span class="title">{item.title}</span>
    <span class="etch">{etch}</span>
  </div>
</a>
