---
import Base from "../layouts/Base.astro";
import CaseCard from "../components/CaseCard.astro";
import { getCases, METHOD_LABELS, ADAPTATION_LABELS } from "../lib/cases";

const cases = getCases();

// Build filter groups only from values actually present in the gallery.
const methods = [...new Set(cases.flatMap((c) => c.methods))].sort();
const dimensions = [...new Set(cases.map((c) => c.dimension))].sort();
const adaptations = [...new Set(cases.map((c) => c.adaptation))].sort();
---

<Base title="samurai gallery">
  <section class="hero">
    <div class="container">
      <span class="eyebrow">◆ adaptive mesh refinement · multiresolution</span>
      <h1>Simulations that <span class="grad">refine themselves</span>.</h1>
      <p class="lead">
        A community gallery of simulation cases built with <strong>samurai</strong>:
        finite-volume schemes on adaptive meshes that put the resolution exactly
        where the physics happens. Explore the code, watch it run, and build your own.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="#cases">Explore the cases ↓</a>
        <a class="btn btn-ghost" href="https://github.com/hpc-maths/samurai" target="_blank" rel="noopener">Get samurai</a>
      </div>
    </div>
  </section>

  <section id="cases" class="container">
    <div class="filters" id="filters">
      <span class="group-label">Method</span>
      {methods.map((m) => (
        <button class="chip" data-group="methods" data-value={m} aria-pressed="false">{METHOD_LABELS[m] ?? m}</button>
      ))}
      <span class="filter-sep"></span>
      <span class="group-label">Dim</span>
      {dimensions.map((d) => (
        <button class="chip" data-group="dimension" data-value={`d${d}`} aria-pressed="false">{d}D</button>
      ))}
      <span class="filter-sep"></span>
      <span class="group-label">Mesh</span>
      {adaptations.map((a) => (
        <button class="chip" data-group="adaptation" data-value={a} aria-pressed="false">{ADAPTATION_LABELS[a] ?? a}</button>
      ))}
    </div>

    <div class="grid" id="grid">
      {cases.map((item) => <CaseCard item={item} />)}
      <p class="empty" id="empty" hidden>No case matches these filters.</p>
    </div>
  </section>

  <script>
    // Client-side filtering: OR within a group, AND across groups.
    const filters = document.getElementById("filters")!;
    const cards = [...document.querySelectorAll<HTMLElement>("#grid .card")];
    const empty = document.getElementById("empty")!;

    const active: Record<string, Set<string>> = {
      methods: new Set(),
      dimension: new Set(),
      adaptation: new Set(),
    };

    function apply() {
      let visible = 0;
      for (const card of cards) {
        const ok = Object.entries(active).every(([group, values]) => {
          if (values.size === 0) return true;
          const attr = card.dataset[group] ?? "";
          const cardValues = attr.split(" ").filter(Boolean);
          return [...values].some((v) => cardValues.includes(v));
        });
        card.style.display = ok ? "" : "none";
        if (ok) visible++;
      }
      empty.hidden = visible !== 0;
    }

    filters.addEventListener("click", (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>(".chip");
      if (!chip) return;
      const group = chip.dataset.group!;
      const value = chip.dataset.value!;
      const pressed = chip.getAttribute("aria-pressed") === "true";
      chip.setAttribute("aria-pressed", String(!pressed));
      if (pressed) active[group].delete(value);
      else active[group].add(value);
      apply();
    });
  </script>
</Base>
