---
import { Code } from "astro:components";
import Base from "../../layouts/Base.astro";
import {
  getCases,
  METHOD_LABELS,
  ADAPTATION_LABELS,
  DIFFICULTY_LABELS,
  REQUIRES_LABELS,
  TAG_LABELS,
  fieldSymbol,
  titleize,
  type GalleryCase,
} from "../../lib/cases";
import { renderMarkdown } from "../../lib/markdown";

export function getStaticPaths() {
  const cases = getCases();
  return cases.map((item, i) => ({
    params: { id: item.id },
    props: {
      item,
      prev: cases[(i - 1 + cases.length) % cases.length],
      next: cases[(i + 1) % cases.length],
    },
  }));
}

const { item, prev, next } = Astro.props as { item: GalleryCase; prev: GalleryCase; next: GalleryCase };
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;

// The page heading already shows the title: drop the README's own top-level
// heading so it is not repeated.
const readmeHtml = renderMarkdown(item.readme.replace(/^\s*#\s[^\n]*\n/, ""));
const media = item.media;
const aspect = media?.aspect ?? 1;

// The samurai version (or engine + version) this case was validated against.
const testedWith = item.engine
  ? item.engineRef
    ? `${item.engine} ${item.engineRef}`
    : item.engine
  : item.samuraiRef
    ? `samurai ${item.samuraiRef}`
    : null;

const fmt = (x: number) => {
  const a = Math.abs(x);
  if (a !== 0 && (a < 1e-2 || a >= 1e4)) return x.toExponential(2);
  return Number(x.toPrecision(3)).toString();
};
const legend = media?.legend ? `linear-gradient(90deg, ${media.legend.join(", ")})` : null;

const spec: [string, string][] = [
  ["Method", item.methods.map((m) => METHOD_LABELS[m] ?? titleize(m)).join(", ")],
  ["Equation", titleize(item.equation)],
  ["Dimension", `${item.dimension}D`],
  ["Mesh", ADAPTATION_LABELS[item.adaptation] ?? item.adaptation],
  ["Level", DIFFICULTY_LABELS[item.difficulty] ?? item.difficulty],
];
if (item.requires.length) spec.push(["Requires", item.requires.map((r) => REQUIRES_LABELS[r] ?? r).join(", ")]);
if (testedWith) spec.push(["Tested with", testedWith]);
if (item.authors.length) spec.push(["Authors", item.authors.join(", ")]);
if (item.tags.length) spec.push(["Tags", item.tags.map((t) => TAG_LABELS[t] ?? t).join(", ")]);
---

<Base title={`${item.title} · samurai gallery`} description={item.summary}>
  <div class="room">
    <nav class="trail etch" aria-label="Breadcrumb">
      <a href={href("/")}>Cases</a>
      <span aria-hidden="true">/</span>
      <a href={href(`/?equation=${item.equation}`)}>{titleize(item.equation)}</a>
    </nav>

    <header class="case-head">
      <div>
        <h1>{item.title}</h1>
        <p>{item.summary}</p>
      </div>
    </header>

    <figure class="monitor" style={`--ar:${aspect}`}>
      <div class="glass">
        {
          media ? (
            <video
              data-dark={href(item.heroDarkUrl)}
              data-light={href(item.heroLightUrl)}
              data-poster-dark={href(item.thumbnailDarkUrl)}
              data-poster-light={href(item.thumbnailLightUrl)}
              data-eager="true"
              src={href(item.heroDarkUrl)}
              poster={href(item.thumbnailDarkUrl)}
              autoplay
              loop
              muted
              playsinline
              aria-label={`${item.title}: animation of the ${media.dimension === 1 ? "solution" : "field and its adaptive mesh"}`}
            />
          ) : (
            <span class="no-signal etch">No signal: media not rendered yet</span>
          )
        }
      </div>
      {
        media && (
          <figcaption class="monitor-bar">
            {legend ? (
              <div class="legend">
                <span class="sym">{fieldSymbol(media.field)}</span>
                <span class="bar" style={`background:${legend}`} role="img" aria-label={`Color scale of ${media.field} from ${fmt(media.range[0])} to ${fmt(media.range[1])}`} />
                <span class="etch">{fmt(media.range[0])} to {fmt(media.range[1])}</span>
              </div>
            ) : (
              <div class="legend">
                <span class="sym">{fieldSymbol(media.field)}</span>
                <span class="etch">range {fmt(media.range[0])} to {fmt(media.range[1])}</span>
              </div>
            )}
            <span />
            <div class="stats etch">
              <span>{media.mesh.levels} mesh levels</span>
              <span>{media.mesh.cells.toLocaleString("en-US")} cells</span>
              <span>{media.frames} frames</span>
            </div>
          </figcaption>
        )
      }
    </figure>

    <div class="case-body">
      <article class="prose" set:html={readmeHtml} />

      <aside class="spec" aria-label="Case sheet">
        <h2>Case sheet</h2>
        <dl>
          {spec.map(([k, v]) => (
            <div class="row">
              <dt class="etch">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
        {item.references.length > 0 && (
          <ul class="refs">
            {item.references.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener">{r.text}</a></li>
            ))}
          </ul>
        )}
      </aside>
    </div>

    <section class="source" aria-labelledby="source-title">
      <div class="source-head">
        <h2 id="source-title">Source</h2>
        <span class="etch">{item.codeFile} · {item.code.split("\n").length} lines</span>
      </div>
      {item.engine && (
        <p class="source-note">
          This case runs on the {item.engine} solver. The code below is its scenario: initial and
          boundary conditions. Fluxes, time integration and mesh adaptation come from the shared solver.
        </p>
      )}
      <Code code={item.code} lang="cpp" themes={{ light: "github-light", dark: "github-dark" }} defaultColor="light" />
    </section>

    <nav class="neighbours" aria-label="Other cases">
      <a class="prev" href={href(`/cases/${prev.id}`)}>
        <span class="etch">Previous screen</span>
        <span class="t">{prev.title}</span>
      </a>
      <a class="next" href={href(`/cases/${next.id}`)}>
        <span class="etch">Next screen</span>
        <span class="t">{next.title}</span>
      </a>
    </nav>
  </div>
</Base>
